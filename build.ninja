# compiles the definitions of source/ for this computer, to check the sizes and
# the offsets that they declare; needs clang (llvm-mingw) in the PATH
#
# No program is built: Windows can refuse to start a program that is not
# signed, so the tools are in Python. The functions of source/ are compiled
# and run by tools/test_functions.py, in an emulator.

cc = clang
cflags = -std=c11 -O2 -g -Wall -Wextra -Wno-four-char-constants -Wno-multichar -Isource

rule cc
  command = $cc $cflags -MD -MF $out.d -c $in -o $out
  depfile = $out.d
  deps = gcc
  description = CC $in

build build/verify_definitions.o: cc tools/verify_definitions.c

default build/verify_definitions.o
