# builds the tools of the Halo 2 decompilation; needs clang (llvm-mingw) in the PATH

cc = clang
cflags = -std=c11 -O2 -g -Wall -Wextra -Wno-four-char-constants -Wno-multichar -Isource/cache

rule cc
  command = $cc $cflags -MD -MF $out.d -c $in -o $out
  depfile = $out.d
  deps = gcc
  description = CC $in

rule link
  command = $cc $in -o $out
  description = LINK $out

build build/cache_files.o: cc source/cache/cache_files.c
build build/mapinfo.o: cc tools/mapinfo/mapinfo.c
build build/mapinfo.exe: link build/mapinfo.o build/cache_files.o

default build/mapinfo.exe
